---
import { imageMetadata } from "astro/assets/utils";
import { readFile } from "node:fs/promises";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { PUBLICATIONS } from "@consts";
import publicationsData from "../data/pubs.json";

const publications = await Promise.all(
  [...publicationsData.publications]
    .sort((a, b) => b.year - a.year)
    .map(async (publication) => ({
      ...publication,
      imageSize: publication.image
        ? await imageMetadata(await readFile(`public${publication.image}`))
        : undefined,
    }))
);
---

<PageLayout title={PUBLICATIONS.TITLE} description={PUBLICATIONS.DESCRIPTION}>
  <Container>
    <header class="page-header">
      <h1>{PUBLICATIONS.TITLE}</h1>
    </header>
      <ul class="publication-list">
        {publications.map((publication) => (
          <li class="publication-item">
            {publication.image ? (
              <img
                src={publication.image}
                alt={publication.title}
                width={publication.imageSize?.width}
                height={publication.imageSize?.height}
                class="publication-image"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="publication-image publication-placeholder" aria-hidden="true"></div>
            )}
            <div class="publication-details">
              <h2 class="publication-title">{publication.title}</h2>
              <p class="publication-authors">
                {publication.authors.map((author, index) => (
                  <Fragment>
                    {author.highlight ? <strong>{author.name}</strong> : <span>{author.name}</span>}
                    {"note" in author && author.note && <span> ({author.note})</span>}
                    {index < publication.authors.length - 1 && <span>, </span>}
                  </Fragment>
                ))}
              </p>
              <p class="publication-venue">
                <em>{publication.venue}</em>, {publication.year}.
                {publication.url && (
                  <>
                    {" "}
                    <a href={publication.url} target="_blank" rel="noopener noreferrer">[paper]</a>
                  </>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
  </Container>
</PageLayout>
