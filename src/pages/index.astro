---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { HOME } from "@consts";
import profile from "../data/profile.json";
import news from "../data/news.json";

const newsItems = [...news.news].sort((a, b) => b.date.localeCompare(a.date));

function formatNewsDate(date: string) {
  const [year, month] = date.split("-");
  return `${month}/${year}`;
}

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="content-section introduction" aria-labelledby="profile-name">
      <div class="profile-heading">
        <img
          src={`/${profile.photo}`}
          alt={profile.name}
          width="72"
          height="72"
          class="profile-photo"
        />
        <div class="profile-identity">
          <h1 id="profile-name">{profile.name}</h1>
          <p class="profile-meta">
            <span>{profile.title}, {profile.affiliation}</span>
            <span aria-hidden="true">&middot;</span>
            <span>{profile.location}</span>
          </p>
        </div>
      </div>
      <div class="about-content">
        {profile.about.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </section>

    <section id="news" class="content-section" aria-labelledby="news-heading">
      <h2 id="news-heading" class="section-heading">Research News</h2>
      <ul class="news-list">
        {newsItems.map((item) => (
          <li class="news-item">
            <time datetime={item.date}>{formatNewsDate(item.date)}</time>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>
  </Container>
</PageLayout>
