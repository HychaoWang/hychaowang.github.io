---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import profile from "../data/profile.json";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <div class="animate flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-3">
            <h1 class="text-2xl font-semibold text-black">
              {profile.name}
            </h1>
            <div class="space-y-1 text-sm">
              <p>AI Researcher</p>
            </div>
          </div>
          <img
            src="/assets/photo.jpg"
            alt={profile.name}
            class="size-28 rounded-full object-cover ring-1 ring-black/10"
          />
        </div>
        <article class="mt-8 space-y-4">
          {profile.about.map((paragraph) => (
            <p class="animate" set:html={paragraph} />
          ))}
        </article>
        <nav class="animate mt-6 space-y-2 text-sm">
          <div class="flex flex-wrap gap-2">
            <Link href="/work">
              Research experience
            </Link>
            <span>/</span>
            <Link href="/projects">
              Publications
            </Link>
          </div>
          <div class="flex flex-wrap gap-2">
            {SOCIALS.map((SOCIAL, index) => (
              <Fragment>
                <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                  {SOCIAL.NAME}
                </Link>
                {index < SOCIALS.length - 1 && <span>/</span>}
              </Fragment>
            ))}
          </div>
        </nav>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col divide-y divide-black/10">
          {blog.map(post => (
            <li class="py-4 first:pt-0 last:pb-0">
              <Link href={`/blog/${post.slug}`} underline={false}>
                <div class="space-y-1 transition-colors hover:text-black">
                  <div class="font-semibold">
                    {post.data.title}
                  </div>
                  <div class="text-sm opacity-75">
                    {post.data.description}
                  </div>
                </div>
              </Link>
            </li>
          ))}
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
